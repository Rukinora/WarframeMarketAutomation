{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "warframemarketautomation",
  "version": "0.1.0",
  "identifier": "com.csrub.warframe",
  
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "warframemarketautomation",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "scope": ["$APP/*", "$RESOURCE/*", "$CONFIG/*", "**"]
    }
  },
  "bundle": {
    "resources": ["bin/main.exe"],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
